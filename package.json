{
  "name": "agent-talk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "check": "cf workers types && vp check",
    "format": "vp fmt",
    "test": "vp test",
    "typecheck": "cf workers types && tsc --noEmit",
    "typecheck:adapter": "tsc --ignoreConfig --noEmit --target es2024 --module preserve --moduleResolution bundler --types node --skipLibCheck --allowImportingTsExtensions adapter/mcp-adapter.ts",
    "mcp": "node --import tsx adapter/mcp-adapter.ts",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test:mls": "node --import tsx --test test/node/*.mjs",
    "posttest": "npm run test:mls",
    "prebuild": "node scripts/build-portal.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.4.0",
    "@hpke/chacha20poly1305": "1.8.1",
    "@hpke/core": "1.10.1",
    "@hpke/dhkem-x25519": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/ed25519": "3.0.0",
    "jose": "6.2.18",
    "ts-mls": "1.6.4",
    "ws": "8.21.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.0",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "cf": "^1.0.0-rc.6",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "ts-mls@1.6.4": {
      "@hpke/chacha20poly1305": "$@hpke/chacha20poly1305"
    }
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}

{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "cloudflare.config.ts", "portal/worker.ts", "portal/cloudflare.config.ts", ".cloudflare/types"]
}
